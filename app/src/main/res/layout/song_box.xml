<!--
the graphical setup for how each song shows up on the main screen.
basically just creates a little box with song details.
TODO: make these boxes clickable
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- album cover -->
    <ImageView
        android:id="@+id/albumCover"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_launcher_foreground" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:gravity="center_vertical">

        <!-- song title -->
        <TextView
            android:id="@+id/songTitle"
            android:text="Song Title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"/>

        <!-- song artist and album (the ID name is a little misleading sorry) -->
        <TextView
            android:id="@+id/songArtist"
            android:text="Artist Name - Album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"/>

    </LinearLayout>

</LinearLayout>