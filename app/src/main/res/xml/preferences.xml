<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.preference.PreferenceCategory
        android:title="Appearance"
        app:iconSpaceReserved="false">
        <ListPreference
            android:key="dark_mode"
            android:title="Theme"
            android:summary="Choose between light, dark, or system default"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:defaultValue="default"
            android:icon="@drawable/brightness_4_24px" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="Library"
        app:iconSpaceReserved="false">
        <ListPreference
            android:key="filter_duration"
            android:title="Filter by Duration"
            android:summary="Hide songs shorter than a certain duration"
            android:entries="@array/duration_filter_entries"
            android:entryValues="@array/duration_filter_values"
            android:defaultValue="0"
            android:icon="@drawable/delete_history_24px" />

        <Preference
            android:key="manage_blacklist"
            android:title="Manage Blacklist"
            android:summary="View and restore blacklisted songs"
            android:icon="@drawable/music_off_24px" />

        <Preference
            android:key="refresh_library"
            android:title="Refresh Library"
            android:summary="Scan for new or updated music files"
            android:icon="@drawable/refresh_24px" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="Playback"
        app:iconSpaceReserved="false">
        <Preference
            android:key="shuffle_algorithms"
            android:title="Shuffling Algorithms"
            android:summary="Change the way your music is shuffled"
            android:fragment="com.example.it391_project_beatbirdie_for_android.ShuffleInfoFragment"
            android:icon="@drawable/shuffle_24px" />

        <androidx.preference.MultiSelectListPreference
            android:key="favourite_shuffle_algorithms"
            android:title="Favourite Shuffling Algorithms"
            android:summary="Select which algorithms appear in the Quick Dropdown"
            android:entries="@array/shuffle_algorithm_names"
            android:entryValues="@array/shuffle_algorithm_names"
            android:icon="@drawable/star_24px" />

        <SwitchPreferenceCompat
            android:key="shuffle_quick_dropdown"
            android:title="Shuffle Algorithm Quick Dropdown"
            android:summary="Show only your favourite shuffling algorithms in the Now Playing menu"
            android:defaultValue="false"
            android:icon="@drawable/bolt_boost_24px" />

        <SwitchPreferenceCompat
            android:key="lock_screen_on"
            android:title="Keep Screen On"
            android:summary="Keep screen on during playback"
            android:icon="@drawable/mobile_lock_portrait_24px" />

        <SwitchPreferenceCompat
            android:key="pause_on_disconnect"
            android:title="Pause on Disconnect"
            android:summary="Automatically pause music when headphones are disconnected"
            android:defaultValue="true"
            android:icon="@drawable/no_sound_24px" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="About"
        app:iconSpaceReserved="false">
        <com.example.it391_project_beatbirdie_for_android.LongClickPreference
            android:key="version_info"
            android:title="Version"
            android:summary="1.0.0"
            android:icon="@drawable/info_24px" />
    </androidx.preference.PreferenceCategory>

</androidx.preference.PreferenceScreen>
